@{
    ViewData["Title"] = "Home Page";
}

<div id="app-container"></div>

<script id="home-template" type="text/x-handlebars-template">
    <div class="view text-center">
    <h1>Welkom bij Muzieknoten</h1>
    </div>
</script>

<script id="oefeningen-menu-template" type="text/x-handlebars-template">
    <div class="oefening-container">
    <div class="oefening-box">
    <p class="box-title">Kies hier wat je wilt oefenen</p>
    <div class="box-grid">
    {{#each oefeningen}}
    <button class="oefening-grid-item" onclick="speelOefening({{id}}, '{{naam}}')">
    {{naam}}
    </button>
    {{else}}
    <p>Geen oefeningen gevonden...</p>
    {{/each}}
                
    <div class="oefening-grid-item disabled">Bass Clef (Binnenkort)</div>
    </div>
    </div>
    </div>
</script>

<script id="treble-clef-template" type="text/x-handlebars-template">
    <div class="view text-center">
    <h2>{{oefeningNaam}}</h2>
        
    <div class="oefening-scherm">

    <svg viewBox="0 0 200 160" class="notenbalk-svg">
    <line x1="10" y1="60" x2="190" y2="60" stroke="black" />
    <line x1="10" y1="70" x2="190" y2="70" stroke="black" />
    <line x1="10" y1="80" x2="190" y2="80" stroke="black" />
    <line x1="10" y1="90" x2="190" y2="90" stroke="black" />
    <line x1="10" y1="100" x2="190" y2="100" stroke="black" />

    <text id="debug-noot-label" x="160" y="30" font-size="12" fill="red">?</text>

    <ellipse id="noot-bolletje-svg" cx="100" cy="100" rx="8" ry="6" fill="black" class="noot-svg" />
    </svg>

    <div id="feedback-bericht" class="feedback-text">
    Klik op de juiste noot...
    </div>

    <div class="btn-group-mobile">
    <button class="btn-noot-guess" onclick="checkAntwoord('A')">A</button>
    <button class="btn-noot-guess" onclick="checkAntwoord('B')">B</button>
    <button class="btn-noot-guess" onclick="checkAntwoord('C')">C</button>
    <button class="btn-noot-guess" onclick="checkAntwoord('D')">D</button>
    <button class="btn-noot-guess" onclick="checkAntwoord('E')">E</button>
    <button class="btn-noot-guess" onclick="checkAntwoord('F')">F</button>
    <button class="btn-noot-guess" onclick="checkAntwoord('G')">G</button>
    </div>
    </div>

    <hr>
        
    <button class="btn-stop-opslaan" onclick="stopEnOpslaan({{oefeningId}})">
    Stoppen & Score Opslaan
    </button>
    </div>
</script>