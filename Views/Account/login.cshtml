@{
    ViewData["Title"] = "Account Page";
    Layout = null;
}
@if (TempData["ErrorMessage"] != null)
{
    <div id="server-error" data-message="@TempData["ErrorMessage"]" style="display:none;"></div>
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Inloggen - Muzieknoten</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<div id="account-app-container" class="container-fluid mt-5"></div>

<script id="account-template" type="text/x-handlebars-template">
    <div class="row justify-content-center px-2">
    <div class="col-12 col-md-8 col-lg-6">
    <div class="view text-center border p-4 p-md-5 shadow-sm bg-white rounded">
    <h1 class="mb-4">Welkom bij Muzieknoten</h1>
    <p class="lead">Log in of maak een account</p>
    <div class="d-grid gap-3">
    <button class="btn btn-primary btn-lg" onclick="showLogin()">Inloggen</button>
    <button class="btn btn-outline-secondary btn-lg" onclick="showRegister()">Registreren</button>
    <hr class="my-3">
                    <div class="d-grid">
                        <button type="button" class="btn btn-outline-secondary btn-lg" onclick="doorgaanAlsGast()">
                            Doorgaan als gast
                        </button>
                    </div>
    </div>
    </div>
    </div>
    </div>
</script>

<script id="login-template" type="text/x-handlebars-template">
    <div class="row justify-content-center px-2"> <div class="col-12 col-sm-8 col-md-6 col-lg-4"> <div class="card shadow">
    <div class="card-body">
    <h3 class="card-title text-center">Inloggen</h3>
    <form action="/Account/Login" method="post">
    <div class="mb-3">
    <label class="form-label">E-mailadres</label>
    <input type="email" name="email" class="form-control form-control-lg" placeholder="naam@voorbeeld.nl" required />
    </div>
    <div class="mb-3">
    <label class="form-label">Wachtwoord</label>
    <input type="password" name="password" class="form-control form-control-lg" required />
    </div>
    <div class="d-grid">
    <button type="submit" class="btn btn-success btn-lg">Inloggen</button>
    </div>
    <div id="login-error-msg" class="text-danger mt-2 text-center"></div>
    
    <button type="button" class="btn btn-link w-100 mt-2 text-decoration-none text-muted" onclick="initApp()">Terug</button>
    </form>
    </div>
    </div>
    </div>
    </div>
</script>

<script id="register-template" type="text/x-handlebars-template">
    <div class="row justify-content-center px-2">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
    <div class="card shadow border-0 rounded-4">
    <div class="card-body p-4">
    <h3 class="card-title text-center mb-4">Account aanmaken</h3>
    <form action="/Account/Register" method="post">
    <div class="mb-3">
    <label class="form-label">E-mailadres</label>
    <input type="email" name="email" class="form-control form-control-lg" placeholder="naam@voorbeeld.nl" required />
    </div>
    <div class="mb-3">
    <label class="form-label">Wachtwoord</label>
    <input type="password" name="password" class="form-control form-control-lg" placeholder="Minimaal 6 tekens" required />
    </div>
    <div class="mb-3">
    <select name="role" class="form-control mb-3">
    <option value="Leerling">Ik ben een Leerling</option>
    <option value="Docent">Ik ben een Docent</option>
    </select>
    </div>
    <div class="d-grid">
    <button type="submit" class="btn btn-primary btn-lg">Registreren</button>
    </div>
    <div id="register-error-msg" class="text-danger mt-2 text-center"></div>
    <button type="button" class="btn btn-link w-100 mt-2 text-decoration-none text-muted" onclick="initApp()">Terug</button>
    </form>
    </div>
    </div>
    </div>
    </div>
</script>

<script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.js"></script>

<script src="~/js/site.js"></script>