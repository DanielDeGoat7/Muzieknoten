<script id="klas-template" type="text/x-handlebars-template">
    <div class="view text-center">
    <h1>Klassen</h1>
        
    <div class="klas-container">
    <button class="btn btn-primary" onclick="toonKlasAanmakenForm()">
    + Nieuwe Klas Aanmaken
    </button>

    <div id="klas-aanmaken-form" style="display: none; margin-top: 20px;">
    <div class="card">
    <div class="card-body">
    <h5 class="card-title">Nieuwe klas aanmaken</h5>
    <input type="text" id="klas-naam" class="form-control" placeholder="Klas naam" />
    <button class="btn btn-success mt-2" onclick="maakKlasAan()">Aanmaken</button>
    <button class="btn btn-secondary mt-2" onclick="annuleerKlasAanmaken()">Annuleren</button>
    </div>
    </div>
    </div>

    <div id="klassen-lijst" class="mt-4">
    <h3>Bestaande klassen</h3>
    {{#if klassen.length}}
    <div class="row">
    {{#each klassen}}
    <div class="col-md-4 mb-3">
    <div class="card">
    <div class="card-body">
    <h5 class="card-title">{{this.naam}}</h5>
    <button class="btn btn-sm btn-info" onclick="bekijkKlasDetails({{this.id}})">Bekijk</button>
    <button class="btn btn-sm btn-danger" onclick="verwijderKlas({{this.id}})">Verwijder</button>
    </div>
    </div>
    </div>
    {{/each}}
    </div>
    {{else}}
    <p>Geen klassen gevonden. Klik op "Nieuwe Klas Aanmaken" om te beginnen.</p>
    {{/if}}
    </div>
    </div>
    </div>
</script>

<script id="klas-details-template" type="text/x-handlebars-template">
    <div class="view">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>{{klas.naam}}</h1>
            <button class="btn btn-secondary" onclick="router.navigeer('klas')">← Terug</button>
        </div>
        
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Klas informatie</h5>
                <p><strong>Docent:</strong> {{klas.docentNaam}}</p>
                <p><strong>Aantal leerlingen:</strong> {{klas.leerlingen.length}}</p>
            </div>
        </div>
        
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">Leerlingen</h5>
                    <button class="btn btn-primary btn-sm" onclick="toonLeerlingToevoegenForm({{klas.id}})">
                        + Leerling toevoegen
                    </button>
                </div>
                
                {{#if klas.leerlingen.length}}
                    <div class="list-group">
                        {{#each klas.leerlingen}}
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>{{this.naam}}</strong>
                                        <span class="badge bg-secondary ms-2">{{this.niveau}}</span>
                                    </div>
                                    <button class="btn btn-sm btn-danger" 
                                            onclick="verwijderLeerling({{../klas.id}}, {{this.id}})">
                                        Verwijder
                                    </button>
                                </div>
                            </div>
                        {{/each}}
                    </div>
                {{else}}
                    <p class="text-muted">Nog geen leerlingen in deze klas.</p>
                {{/if}}
            </div>
        </div>
    </div>
    
    <div id="leerling-toevoegen-form" style="display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 1000; background: white; padding: 25px; border-radius: 10px; box-shadow: 0 5px 20px rgba(0,0,0,0.3); width: 90%; max-width: 400px;">
        <h3 class="mb-3">Leerling toevoegen</h3>
        <div class="mb-3">
            <label class="form-label">Emailadres *</label>
            <input type="email" id="leerling-email" class="form-control" placeholder="leerling@school.nl">
            <small class="text-muted">De leerling moet al geregistreerd zijn</small>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-success" onclick="voegLeerlingToe()">Toevoegen</button>
            <button class="btn btn-secondary" onclick="annuleerLeerlingToevoegen()">Annuleren</button>
        </div>
    </div>
</script>

<script id="leerling-dashboard-template" type="text/x-handlebars-template">
    <div class="view text-center">
        <h1>Mijn Voortgang</h1>
        
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Resultaten</h5>
                
                {{#if resultaten.length}}
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Oefening</th>
                                    <th>Score</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each resultaten}}
                                <tr>
                                    <td>{{formatDate this.datum}}</td>
                                    <td>{{this.oefeningNaam}}</td>
                                    <td>{{this.weergaveScore}}</td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                {{else}}
                    <p class="text-muted">Nog geen resultaten. Maak eerst een oefening!</p>
                {{/if}}
            </div>
        </div>
    </div>
</script>

<script id="docent-dashboard-template" type="text/x-handlebars-template">
    <div class="view">
        <h1>Mijn Leerlingen</h1>
        
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Leerlingenoverzicht</h5>
                
                {{#if leerlingen.length}}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Email</th>
                                    <th>Niveau</th>
                                    <th>Klas</th>
                                    <th>Resultaten</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each leerlingen}}
                                <tr onclick="bekijkLeerlingVoortgang({{this.leerlingId}})" style="cursor: pointer;">
                                    <td>{{this.email}}</td>
                                    <td><span class="badge bg-secondary">{{this.niveau}}</span></td>
                                    <td>{{this.klasNaam}}</td>
                                    <td>{{this.aantalResultaten}}</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" onclick="event.stopPropagation(); bekijkLeerlingVoortgang({{this.leerlingId}})">Bekijk</button>
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                {{else}}
                    <p class="text-muted">Je hebt nog geen leerlingen in je klassen.</p>
                {{/if}}
            </div>
        </div>
    </div>
</script>

<script id="docent-leerling-voortgang-template" type="text/x-handlebars-template">
    <div class="view">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>Voortgang: {{leerlingNaam}}</h1>
            <button class="btn btn-secondary" onclick="router.navigeer('docent-dashboard')">← Terug</button>
        </div>
        
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Leerlinggegevens</h5>
                <p><strong>Email:</strong> {{leerlingEmail}}</p>
                <p><strong>Klas:</strong> {{klasNaam}}</p>
                <p><strong>Aantal oefeningen gemaakt:</strong> {{resultaten.length}}</p>
            </div>
        </div>
        
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Resultaten</h5>
                
                {{#if resultaten.length}}
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Oefening</th>
                                    <th>Score</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each resultaten}}
                                <tr>
                                    <td>{{formatDate this.datum}}</td>
                                    <td>{{this.oefeningNaam}}</td>
                                    <td>{{this.weergaveScore}}</td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                {{else}}
                    <p class="text-muted">Deze leerling heeft nog geen oefeningen gemaakt.</p>
                {{/if}}
            </div>
        </div>
    </div>
</script>