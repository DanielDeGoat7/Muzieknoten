@{
    ViewData["Title"] = "Home Page";
}

<div id="app-container"></div>

<script id="home-template" type="text/x-handlebars-template">
    <div class="view text-center">
    <h1>Welkom bij Muzieknoten</h1>
    </div>
</script>

<script id="oefeningen-menu-template" type="text/x-handlebars-template">
    <div class="oefening-container">
    <div class="oefening-box">
    <p class="box-title">Kies hier wat je wilt oefenen</p>
    <div class="box-grid">
    {{#each oefeningen}}
    <button class="oefening-grid-item" onclick="speelOefening({{id}}, '{{naam}}')">
    {{naam}}
    </button>
    {{else}}
    <p>Geen oefeningen gevonden...</p>
    {{/each}}
                
    <div class="oefening-grid-item disabled">Bass Clef (Binnenkort)</div>
    </div>
    </div>
    </div>
</script>

<script id="treble-clef-template" type="text/x-handlebars-template">
    <div class="view text-center">
    <h1>Oefening: {{oefeningNaam}}</h1>
    <div class="piano-placeholder">
    <p>ID van deze oefening: {{oefeningId}}</p>
    <p>ToDo: Notenbalken en Piano logica...</p>
    <hr>
    <button class="btn-save-score" onclick="verstuurScoreNaarServer(85, {{oefeningId}})">
    Oefening afronden en score opslaan
    </button>
    </div>
    </div>
</script>